{
  "host": "https://web-production-0e178.up.railway.app",
  "defaultEntryMac": "/path/to/mirror-memory-mcp/dist/index.js",
  "tools": [
    "search_history",
    "get_thread",
    "list_pins",
    "write_note",
    "search_notes",
    "append_memory"
  ],
  "clients": {
    "cursor": {
      "path": "~/.cursor/mcp.json",
      "rootKey": "mcpServers",
      "serverName": "mirror-memory",
      "config": {
        "command": "npx",
        "args": [
          "-y",
          "mirror-memory-mcp@0.1.1"
        ],
        "env": {
          "MIRROR_API_BASE": "https://web-production-0e178.up.railway.app",
          "MIRROR_MEMORY_TOKEN": "{{TOKEN}}"
        }
      },
      "configPaths": {
        "macos": "~/.cursor/mcp.json",
        "linux": "~/.cursor/mcp.json",
        "windows": "%USERPROFILE%\\\\.cursor\\\\mcp.json"
      },
      "reload": "Settings \u2192 MCP toggle off/on, or reload window",
      "installDoc": "INSTALL_CURSOR_NPM.md"
    },
    "claudeDesktop": {
      "path": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "rootKey": "mcpServers",
      "serverName": "mirror-memory",
      "config": {
        "command": "npx",
        "args": [
          "-y",
          "mirror-memory-mcp@0.1.1"
        ],
        "env": {
          "MIRROR_API_BASE": "https://web-production-0e178.up.railway.app",
          "MIRROR_MEMORY_TOKEN": "{{TOKEN}}"
        }
      },
      "relaunch": "full quit Cmd-Q (macOS); window close is not enough",
      "configPaths": {
        "macos": "~/Library/Application Support/Claude/claude_desktop_config.json",
        "windows": "%APPDATA%\\\\Claude\\\\claude_desktop_config.json",
        "linux": "~/.config/Claude/claude_desktop_config.json"
      },
      "installDoc": "INSTALL_CLAUDE_DESKTOP_NPM.md"
    },
    "devinLocal": {
      "path": "~/.config/devin/mcp_config.json",
      "rootKey": "mcpServers",
      "serverName": "mirror-memory",
      "config": {
        "command": "npx",
        "args": [
          "-y",
          "mirror-memory-mcp@0.1.1"
        ],
        "env": {
          "MIRROR_API_BASE": "https://web-production-0e178.up.railway.app",
          "MIRROR_MEMORY_TOKEN": "{{TOKEN}}"
        }
      },
      "cli": "devin mcp add -s user mirror-memory ...",
      "cloudStdio": false
    }
  },
  "softProCapture": "HOLD",
  "defaultEntry": "/path/to/mirror-memory-mcp/dist/index.js",
  "cloneUrl": "https://github.com/kestrel-devagent/mirror-memory-mcp.git",
  "repoUrl": "https://github.com/kestrel-devagent/mirror-memory-mcp",
  "npmStatus": "LIVE",
  "npmCutover": "NPM_ENTRY_CUTOVER.md \u2014 LIVE with MIRROR_MCP_NPM_LIVE=1",
  "npmPackage": "mirror-memory-mcp@0.1.1"
}
