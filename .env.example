# Mirror Memory MCP — copy to .env for local runs, or set in Cursor mcp.json env.

# Live Railway host (default). Override for local next dev.
MIRROR_API_BASE=https://web-production-0e178.up.railway.app

# Bearer token: Mirror session token OR extension sync token from the signed-in
# /upload page (same credentials Builder wires into getMemoryUser).
# Never commit a real token.
MIRROR_MEMORY_TOKEN=
